{
  "name": "mesh402",
  "version": "0.1.0",
  "private": true,
  "description": "Open marketplace where AI agents discover and pay for DVMs (Data Vending Machines) on TON",
  "workspaces": [
    "packages/ton",
    "gateway",
    "agent",
    "mini-app",
    "bot"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "dev:gateway": "npm run dev --workspace=gateway",
    "dev:agent": "npm run dev --workspace=agent",
    "dev:mini-app": "npm run dev --workspace=mini-app",
    "dev:bot": "npm run dev --workspace=bot"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {},
  "overrides": {
    "@ton/core": "^0.62.0"
  }
}
